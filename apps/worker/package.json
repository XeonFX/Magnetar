{
  "name": "@magnetar/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../web build && wrangler dev --env dev --port 8790",
    "deploy": "bun run --cwd ../web build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply magnetar --local --env dev",
    "migrate:remote": "wrangler d1 migrations apply magnetar --remote",
    "typecheck": "tsc -p . && tsc -p test"
  },
  "dependencies": {
    "@codefusion-cc/web-push": "^1.1.0",
    "@magnetar/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "wrangler": "^4.142.0"
  }
}
