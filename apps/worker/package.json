{
  "name": "@magnetar/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @magnetar/web && wrangler dev --env dev --port 8790",
    "deploy": "npm run build -w @magnetar/web && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply magnetar --local --env dev",
    "migrate:remote": "wrangler d1 migrations apply magnetar --remote",
    "typecheck": "tsc -p . && tsc -p test"
  },
  "dependencies": {
    "@codefusion-cc/app-update": "^0.1.0",
    "@codefusion-cc/base58": "^0.1.0",
    "@codefusion-cc/console": "^0.10.0",
    "@codefusion-cc/google-sign-in": "^0.1.0",
    "@codefusion-cc/web-push": "^0.1.0",
    "@codefusion-cc/workers-crypto": "^0.1.0",
    "@codefusion-cc/workers-http": "^0.1.0",
    "@magnetar/protocol": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "wrangler": "^4.142.0"
  }
}
